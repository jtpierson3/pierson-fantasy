// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RosterSlot {
  STARTER
  SUB
  RESERVE
  IR
}

// ===================================================
//      Fantasy Football
// ===================================================

model User {
  id               String                        @id @default(cuid())
  clerkId          String                        @unique
  username         String
  email            String
  isSiteAdmin      Boolean                       @default(false)
  leagues          FantasyLeagueMember[]
  fantasyTeams     FantasyTeam[]
  eliminationPicks EliminationPick[]
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  survivorLeagues  SurvivorFantasyLeagueMember[]
  leagueTribe      SurvivorFantasyLeagueTribe[]
}

model FantasyLeague {
  id          String                @id @default(cuid())
  name        String
  description String?
  members     FantasyLeagueMember[]
  teams       FantasyTeam[]
  gameweeks   FantasyGameweek[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model FantasyLeagueMember {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id])
  userId          String
  fantasyLeague   FantasyLeague @relation(fields: [fantasyLeagueId], references: [id])
  fantasyLeagueId String
  isAdmin         Boolean       @default(false)
  points          Int           @default(0)

  @@unique([userId, fantasyLeagueId])
}

model FantasyTeam {
  id                 String              @id @default(cuid())
  name               String
  formation          String              @default("4-3-3")
  wins               Int                 @default(0)
  losses             Int                 @default(0)
  draws              Int                 @default(0)
  totalLeaguePoints  Int                 @default(0)
  totalFantasyPoints Int                 @default(0)
  standingsChange    Int                 @default(0)
  user               User                @relation(fields: [userId], references: [id])
  userId             String              @unique
  fantasyLeague      FantasyLeague       @relation(fields: [fantasyLeagueId], references: [id])
  fantasyLeagueId    String
  players            FantasyTeamPlayer[]
  homeMatchups       FantasyMatchup[]    @relation("HomeMatchups")
  awayMatchups       FantasyMatchup[]    @relation("AwayMatchups")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, fantasyLeagueId])
}

model FantasyTeamPlayer {
  id            String      @id @default(cuid())
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id])
  fantasyTeamId String
  player        Player      @relation(fields: [playerId], references: [id])
  playerId      Int
  rosterSlot    RosterSlot  @default(RESERVE)
  slotOrder     Int         @default(0)
  addedAt       DateTime    @default(now())

  @@unique([fantasyTeamId, playerId])
}

model FantasyGameweek {
  id              String           @id @default(cuid())
  fantasyLeague   FantasyLeague    @relation(fields: [fantasyLeagueId], references: [id])
  fantasyLeagueId String
  gameweekNumber  Int
  startDate       DateTime
  endDate         DateTime
  isComplete      Boolean          @default(false)
  isCurrent       Boolean          @default(false)
  matchups        FantasyMatchup[]
  createdAt       DateTime         @default(now())

  @@unique([fantasyLeagueId, gameweekNumber])
}

model FantasyMatchup {
  id         String          @id @default(cuid())
  gameweek   FantasyGameweek @relation(fields: [gameweekId], references: [id])
  gameweekId String
  homeTeam   FantasyTeam     @relation("HomeMatchups", fields: [homeTeamId], references: [id])
  homeTeamId String
  awayTeam   FantasyTeam     @relation("AwayMatchups", fields: [awayTeamId], references: [id])
  awayTeamId String
  homePoints Int             @default(0)
  awayPoints Int             @default(0)
  isComplete Boolean         @default(false)
  createdAt  DateTime        @default(now())
}

// ===========================================
//          Football Data Models
// ===========================================

model League {
  id         Int      @id
  name       String
  short_code String?
  image_path String
  season_id  Int
  teams      Team[]
  updatedAt  DateTime @updatedAt
}

model Team {
  id         Int      @id
  name       String
  short_code String?
  image_path String
  league     League   @relation(fields: [leagueId], references: [id])
  leagueId   Int
  players    Player[]
  updatedAt  DateTime @updatedAt
}

model Player {
  id             Int                 @id
  display_name   String
  image_path     String
  position_id    Int
  jersey_number  Int?
  date_of_birth  String?
  team           Team                @relation(fields: [teamId], references: [id])
  teamId         Int
  fantasyPlayers FantasyTeamPlayer[]
  updatedAt      DateTime            @updatedAt
}

//------------------------------ SURVIVOR ----------------------------------

model SurvivorPlayer {
  id          String       @id @default(cuid())
  name        String       @unique
  bio         String?
  birthDate   DateTime?
  contestants Contestant[]
}

model SurvivorSeason {
  id            String           @id @default(cuid())
  number        Int
  title         String
  theme         String?
  location      String?
  imageUrl      String?
  airDate       DateTime?
  finaleDate    DateTime?
  summary       String?
  production    String?
  twists        String?
  isActive      Boolean          @default(false)
  castawayCount Int?
  contestants   Contestant[]
  episodes      Episode[]
  tribes        Tribe[]
  scoringEvents ScoringEvent[]
  leagues       SurvivorLeague[]
}

model Tribe {
  id               String            @id @default(cuid())
  name             String
  color            String
  survivorSeasonId String
  survivorSeason   SurvivorSeason    @relation(fields: [survivorSeasonId], references: [id])
  memberships      TribeMembership[]
}

model Episode {
  id               String            @id @default(cuid())
  number           Int
  name             String
  airDate          DateTime
  isAired          Boolean           @default(false)
  isMerge          Boolean           @default(false)
  isFinale         Boolean           @default(false)
  description      String?
  survivorSeasonId String
  survivorSeason   SurvivorSeason    @relation(fields: [survivorSeasonId], references: [id])
  stats            EpisodeStat[]
  challenges       Challenge[]
  tribalCouncils   TribalCouncil[]
  eliminationPicks EliminationPick[]
  tribeMemberships TribeMembership[]

  @@unique([survivorSeasonId, number])
}

model Contestant {
  id                String            @id @default(cuid())
  survivorPlayerId  String
  survivorSeasonId  String
  survivorPlayer    SurvivorPlayer    @relation(fields: [survivorPlayerId], references: [id])
  survivorSeason    SurvivorSeason    @relation(fields: [survivorSeasonId], references: [id])
  status            String
  eliminatedEpisode Int?
  placement         Int?
  daysLasted        Int?
  imageUrl          String?
  hometown          String?
  occupation        String?
  profile           String?
  description       String?
  tribeMemberships  TribeMembership[]
  episodeStats      EpisodeStat[]
  survivorPicks     SurvivorPicks[]
  eliminationPicks  EliminationPick[]
  sitOuts           SitOut[]
  challengeResults  ChallengeResult[] @relation("IndividualWinner")
  challengeTeams    ChallengeTeam[]   @relation("ChallengeTeamContestants")
  votesGiven        VotingRecord[]    @relation("Voter")
  votesReceived     VotingRecord[]    @relation("VotedFor")
  eliminations      TribalCouncil[]   @relation("Eliminated")

  @@unique([survivorPlayerId, survivorSeasonId])
}

model TribeMembership {
  id           String     @id @default(cuid())
  contestantId String
  tribeId      String
  tribeType    String
  episodeId    String?
  isCurrent    Boolean    @default(true)
  contestant   Contestant @relation(fields: [contestantId], references: [id])
  tribe        Tribe      @relation(fields: [tribeId], references: [id])
  episode      Episode?   @relation(fields: [episodeId], references: [id])
}

model ScoringEvent {
  id               String          @id @default(cuid())
  label            String
  points           Int
  category         String
  stats            EpisodeStat[]
  survivorSeason   SurvivorSeason? @relation(fields: [survivorSeasonId], references: [id])
  survivorSeasonId String?
}

model EpisodeStat {
  id           String       @id @default(cuid())
  episodeId    String
  contestantId String
  eventId      String
  order        Int          @default(0)
  description  String?
  episode      Episode      @relation(fields: [episodeId], references: [id])
  contestant   Contestant   @relation(fields: [contestantId], references: [id])
  event        ScoringEvent @relation(fields: [eventId], references: [id])
}

model SurvivorLeague {
  id               String                        @id @default(cuid())
  name             String
  survivorSeason   SurvivorSeason                @relation(fields: [survivorSeasonId], references: [id])
  survivorSeasonId String
  members          SurvivorFantasyLeagueMember[]
  tribes           SurvivorFantasyLeagueTribe[]
  eliminationPicks EliminationPick[]
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @default(now())
}

model SurvivorFantasyLeagueMember {
  id               String         @id @default(cuid())
  user             User           @relation(fields: [userId], references: [id])
  userId           String
  survivorLeague   SurvivorLeague @relation(fields: [survivorLeagueId], references: [id])
  survivorLeagueId String
  isAdmin          Boolean        @default(false)
  points           Int            @default(0)

  @@unique([userId, survivorLeagueId])
}

model SurvivorFantasyLeagueTribe {
  id               String          @id @default(cuid())
  name             String
  user             User            @relation(fields: [userId], references: [id])
  userId           String
  survivorLeague   SurvivorLeague  @relation(fields: [survivorLeagueId], references: [id])
  survivorLeagueId String
  players          SurvivorPicks[]
  hasUsedMergeSwap Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, survivorLeagueId])
}

model SurvivorPicks {
  id           String                     @id @default(cuid())
  tribe        SurvivorFantasyLeagueTribe @relation(fields: [tribeId], references: [id])
  tribeId      String
  contestant   Contestant                 @relation(fields: [contestantId], references: [id])
  contestantId String
  isSwap       Boolean                    @default(false)
  addedAt      DateTime                   @default(now())

  @@unique([tribeId, contestantId])
}

model Challenge {
  id           String            @id @default(cuid())
  episode      Episode           @relation(fields: [episodeId], references: [id])
  episodeId    String
  name         String?
  type         String
  isIndividual Boolean           @default(true)
  isFiremaking Boolean           @default(false)
  reward       String?
  teams        ChallengeTeam[]
  results      ChallengeResult[]
  sitOuts      SitOut[]
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
}

model ChallengeTeam {
  id          String           @id @default(cuid())
  challenge   Challenge        @relation(fields: [challengeId], references: [id])
  challengeId String
  name        String?
  color       String?
  contestants Contestant[]     @relation("ChallengeTeamContestants")
  result      ChallengeResult?
}

model ChallengeResult {
  id           String         @id @default(cuid())
  challenge    Challenge      @relation(fields: [challengeId], references: [id])
  challengeId  String
  contestant   Contestant?    @relation("IndividualWinner", fields: [contestantId], references: [id])
  contestantId String?
  team         ChallengeTeam? @relation(fields: [teamId], references: [id])
  teamId       String?        @unique
  placement    Int
}

model TribalCouncil {
  id            String         @id @default(cuid())
  episode       Episode        @relation(fields: [episodeId], references: [id])
  episodeId     String
  order         Int            @default(1)
  isFiremaking  Boolean        @default(false)
  isFinalTribal Boolean        @default(false)
  notes         String?
  votes         VotingRecord[]
  eliminated    Contestant?    @relation("Eliminated", fields: [eliminatedId], references: [id])
  eliminatedId  String?
  createdAt     DateTime       @default(now())
}

model VotingRecord {
  id              String        @id @default(cuid())
  tribalCouncil   TribalCouncil @relation(fields: [tribalCouncilId], references: [id])
  tribalCouncilId String
  voter           Contestant    @relation("Voter", fields: [voterId], references: [id])
  voterId         String
  votedFor        Contestant    @relation("VotedFor", fields: [votedForId], references: [id])
  votedForId      String
  isRevoked       Boolean       @default(false)
}

model SitOut {
  id           String     @id @default(cuid())
  challengeId  String
  contestantId String
  challenge    Challenge  @relation(fields: [challengeId], references: [id])
  contestant   Contestant @relation(fields: [contestantId], references: [id])

  @@unique([challengeId, contestantId])
}

model EliminationPick {
  id               String         @id @default(cuid())
  userId           String
  survivorLeagueId String
  episodeId        String
  contestantId     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id])
  survivorLeague   SurvivorLeague @relation(fields: [survivorLeagueId], references: [id])
  episode          Episode        @relation(fields: [episodeId], references: [id])
  contestant       Contestant     @relation(fields: [contestantId], references: [id])

  @@unique([userId, survivorLeagueId, episodeId])
}
